# Oracle connection (composed in Program.cs — N-09)
DB_USER=system
DB_PASS=oracle
DB_HOST=oracle            # service name on pulso-net in docker-compose; use "localhost" for local dev
DB_PORT=1521
DB_SERVICE=XEPDB1

# Shared JWT secret — MUST equal the Java API's JWT_SECRET env var exactly (Q-01)
JWT_SECRET=pulso-secret-2026

# Kestrel
ASPNETCORE_URLS=http://+:5000
ASPNETCORE_ENVIRONMENT=Production
